@using RealTimeNotificationCenter.Models.ViewModels

@{
    Layout = null;
    ViewData["Title"] = "Sign In";
}

@model SignInViewModel

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Giriş Yap</title>

    <link rel="stylesheet" href="~/css/signIn.css" asp-append-version="true" />
</head>

<body>

    <div class="login-container">

        <div class="login-card">

            <div class="login-header">
                <h1>🔔 Bildirim Merkezi</h1>
                <p>Devam etmek için giriş yapın</p>
            </div>

            <form action="/User/SignIn" method="post">

                <div asp-validation-summary="ModelOnly"></div>
                <div class="form-group">
                    <label>Kullanıcı Adı veya Email</label>
                    <input name="UserNameOrEmail" type="text" class="form-control" placeholder="Kullanıcı adı veya ornek@email.com" required />
                </div>

                <div class="form-group">
                    <label>Şifre</label>
                    <input name="Password" type="password" class="form-control" placeholder="Şifrenizi girin" required />
                </div>

                <button type="submit" class="btn-primary"> Giriş Yap</button>

            </form>

            <div class="register-link">
                Hesabınız yok mu?
                <a href="/User/SignUp">Kayıt Ol</a>
            </div>

        </div>

    </div>

</body>
</html>